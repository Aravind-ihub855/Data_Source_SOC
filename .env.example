# -------------------------------------------------------------
# Synthetic Security Data Generator Configuration
# -------------------------------------------------------------
PORT=8002
HOST=0.0.0.0
RELOAD=false
STREAM_AUTO_START=true
BUFFER_MAX_SIZE=2000

# Event generation rates (events per minute at peak working hours)
DEFENDER_RATE_PER_MIN=30
ENTRA_RATE_PER_MIN=20
CLOUDTRAIL_RATE_PER_MIN=10
WINDOWS_RATE_PER_MIN=20
FIREWALL_RATE_PER_MIN=15

# Scenario pacer
SCENARIO_PACER_ENABLED=true
SCENARIO_INTERVAL_MIN=4.0

# Tenants (first one is the default for manual scenario triggers)
TENANTS=tnt-acme,tnt-globex
# Same seed + same backfill window = the same events
SEED=20261124
# Working-hours curve in the business's local time (New York = -5; set 5.5 to follow IST)
DIURNAL_CURVE=true
BUSINESS_UTC_OFFSET_HOURS=-5

# Injected data-quality faults (fraction of events); every one is labelled in ground truth
FAULT_DUPLICATE_RATE=0.015
FAULT_LATE_RATE=0.02
FAULT_TRUNCATED_RATE=0.003
FAULT_SCHEMA_DRIFT_RATE=0.001

# Labels and undeliverable batches (never sent to Splunk)
GROUND_TRUTH_PATH=out/ground_truth.jsonl
DEAD_LETTER_PATH=out/dead_letter.jsonl

# Optional: also post every delivered HEC batch here (e.g. the Albertson backend)
MIRROR_URL=
# Browser origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# -------------------------------------------------------------
# Splunk HTTP Event Collector (HEC)
# -------------------------------------------------------------
SPLUNK_HEC_URL=https://localhost:8088/services/collector/event
SPLUNK_HEC_TOKEN=
SPLUNK_HEC_VERIFY_SSL=false

# Splunk Indexes (created by Data_Pipeline_SOC/splunk/splunk_tools.py setup)
SPLUNK_INDEX_ENDPOINT=security_endpoint
SPLUNK_INDEX_CLOUD=security_cloud
SPLUNK_INDEX_AUTH=security_identity
SPLUNK_INDEX_NETWORK=security_network

# Delivery tuning (indexer acknowledgement is used automatically if the token has it on)
SPLUNK_BATCH_SIZE=500
SPLUNK_CONCURRENCY=16
SPLUNK_FLUSH_INTERVAL_SEC=2.0
SPLUNK_TIMEOUT_SEC=5.0
SPLUNK_MAX_RETRIES=5
SPLUNK_ACK_TIMEOUT_SEC=30
