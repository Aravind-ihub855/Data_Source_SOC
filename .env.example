# -------------------------------------------------------------
# Synthetic Security Data Generator Configuration
# -------------------------------------------------------------
PORT=8002
HOST=0.0.0.0
STREAM_AUTO_START=true
BUFFER_MAX_SIZE=2000

# Event Generation Rates (events per 1-minute window)
DEFENDER_RATE_PER_MIN=30
ENTRA_RATE_PER_MIN=20
CLOUDTRAIL_RATE_PER_MIN=10
POWERSHELL_RATE_PER_MIN=15

# -------------------------------------------------------------
# Splunk HTTP Event Collector (HEC) Configuration
# (Can be set up later with your real Splunk credentials)
# -------------------------------------------------------------
SPLUNK_HEC_URL=http://localhost:8088/services/collector/event
SPLUNK_HEC_TOKEN=
SPLUNK_HEC_VERIFY_SSL=false

# Splunk Indexes
SPLUNK_INDEX_ENDPOINT=endpoint
SPLUNK_INDEX_CLOUD=cloud
SPLUNK_INDEX_AUTH=authentication

# Delivery Tuning
SPLUNK_BATCH_SIZE=10
SPLUNK_FLUSH_INTERVAL_SEC=2.0
SPLUNK_TIMEOUT_SEC=5.0
SPLUNK_MAX_RETRIES=3
